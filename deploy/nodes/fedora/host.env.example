# Per-host settings for bootstrap.sh. Copy to host.env beside the script and
# edit; host.env is read by `bootstrap.sh --check`, or pass --env FILE.

# vendor:device ids of the passthrough GPU and its audio function (lspci -nn).
# When unset, bootstrap.sh uses the ids on the kernel command line
# (vfio-pci.ids=...). The GTX 1060 6GB on FED-D is:
VFIO_IDS=10de:1c03,10de:10f1

# 1 (default): this host passes a GPU through. 0: a CPU-only node, so the
# IOMMU, VFIO and driver checks are skipped.
EXPECT_GPU=1

# The libvirt network the agent attaches guests to (default kdk-net).
# NET=kdk-net
