# Build output
/bin/
/dist/

# Go
*.test
*.out
coverage.*
# Spike code under hack/ carries its own go.mod; a local go.work would pull it into ./...
/go.work
/go.work.sum

# JavaScript
node_modules/
# The web build is embedded into the Go binary (web/embed.go). Only the empty
# placeholder that keeps the directory is tracked, so `go build` needs no Node.
/web/dist/*
!/web/dist/.gitkeep

# Guest images built locally (P1.6)
/deploy/images/dist/

# Demo script output, such as the happy path's timing log (P4.5)
/.demo/

# Local configuration and secrets
.env
.env.*
!.env.example

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
