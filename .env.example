# Copy to .env and adjust. The Makefile passes .env to docker compose when it
# exists, else this file.

# Postgres in deploy/compose/compose.yaml.
POSTGRES_USER=kondukter
POSTGRES_PASSWORD=kondukter
POSTGRES_DB=kondukter
# Host address and port the container publishes on. 55432 avoids clashing
# with a Postgres installed on the host.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=55432

# Used by host-side tools and tests (goose, sqlc, go test) against the
# compose Postgres. Keep in sync with the values above.
KONDUKTER_DATABASE_URL=postgres://kondukter:kondukter@localhost:55432/kondukter?sslmode=disable

# The demo control plane (`make demo-up`, hack/demo.sh). demo-up generates
# both into .env on its first run. The master key seals the CA stored in the
# Postgres volume: losing it means re-enrolling every node.
KONDUKTER_MASTER_KEY=
# Password of the seeded customer@, partner@ and operator@demo.local.
SEED_PASSWORD=
# demo-up advertises this Mac's MagicDNS name and tailnet IP (from
# `tailscale status`); set these to override. Published ports, and the
# address they bind (all interfaces by default, the tailnet's included).
# KONDUKTER_HOST=
# KONDUKTER_TAILNET_IP=
# KONDUKTER_BIND=0.0.0.0
# KONDUKTER_API_PORT=8080
# KONDUKTER_GATEWAY_PORT=8443
# KONDUKTER_IMAGES_PORT=8081
